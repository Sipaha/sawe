GIGAAM_MODEL = "gigaam-v3-ctc"
GIGAAM_REV = "322c3b29492673eb7d0b434bfa9dfb8653e34d02"
GIGAAM_HASHES = {
    "config.json": "0641fcf73f4af791c73f05083e38a658ff5dcbee3534a0c61396c10f4b97f0fe",
