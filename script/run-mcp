#!/usr/bin/env bash
# Launch sawe with the MCP socket exposed for autonomous agent driving.
# The MCP socket lives at ~/.spk/sawe[-dev]/state/mcp.sock by default;
# pass --runtime-dir <path> to run a fully isolated instance instead.
#
# Usage:
#   script/run-mcp                # uses $DISPLAY if set, otherwise --headless
#   script/run-mcp --headless     # native headless platform — no X / Wayland
#                                 # connection, no window on the user's
#                                 # desktop, no Xvfb. workspace.screenshot
#                                 # captures real rendered pixels via the
#                                 # offscreen wgpu pipeline.
#   script/run-mcp --display      # use the existing $DISPLAY (fails if unset)
#   script/run-mcp --debug        # use the dev (debug) build — much faster to
#                                 # rebuild during iteration; runtime is slower
#   script/run-mcp --release      # use target/release/sawe (default)
#   script/run-mcp --runtime-dir DIR  # full isolation: runs the editor with
#                                     # SAWE_HOME=DIR, so its settings, db,
#                                     # cache and MCP socket all land under
#                                     # DIR/.spk/sawe[-dev]/ and it cannot
#                                     # contend the real instance's lock
#   script/run-mcp -- <args>      # pass extra args to sawe
#
# Behavior:
# - Builds the chosen binary (release by default, dev with --debug) if missing.
# - Waits for the MCP socket to appear (timeout 30s) and prints its path
#   so callers can pipe into a follow-up command.
# - Forwards SIGINT/SIGTERM to the editor process.
#
# The script is idempotent against stale lock files: if mcp.lock exists
# but its PID is dead, the editor reclaims it. If a real instance holds
# the lock, this script's editor exits via the handoff path.
#
# Uses the native headless GPUI platform in --headless mode (ADR-0002);
# no Xvfb required.

set -euo pipefail

mode=""
forward_args=()
runtime_dir=""
profile="release"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --headless)
            mode="headless"
            shift
            ;;
        --display)
            mode="display"
            shift
            ;;
        --debug)
            profile="dev"
            shift
            ;;
        --release)
            profile="release"
            shift
            ;;
        --runtime-dir)
            runtime_dir="$2"
            shift 2
            ;;
        --skip-onboarding)
            cat >&2 <<'MSG'
[run-mcp] --skip-onboarding did nothing and has been removed.
  It seeded `first_open` into $XDG_DATA_HOME/sawe/db/, which this fork never
  reads: the kvp database is paths::data_dir()/db/0-<channel>, i.e. under
  ~/.spk/sawe[-dev]/data/. And the branch it aimed at is gone -- cold launch in
  crates/zed/src/main.rs always calls show_onboarding_view (Welcome is this
  fork's launcher for every launch, not only the first), so no value of
  `first_open` suppresses it.
  Drive past Welcome over the MCP socket instead, e.g. solutions.open.
MSG
            exit 2
            ;;
        --)
            shift
            forward_args=("$@")
            break
            ;;
        *)
            echo "unknown flag: $1" >&2
            exit 2
            ;;
    esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ "$profile" == "dev" ]]; then
    binary="$repo_root/target/debug/sawe"
    cargo_flags=(--bin sawe)
else
    binary="$repo_root/target/release/sawe"
    cargo_flags=(--release --bin sawe)
fi

# Resolve socket_dir + socket_path UP FRONT (before build / xvfb checks /
# any other early-exit path), then strip stale state immediately. If we
# fail-fast later (e.g. xvfb-run missing), we don't leave a stale socket
# symlink around to fool a follow-up `until [ -S "$socket_path" ]` wait
# into thinking the editor is ready.

# Mirror `paths::dir_name_kebab()`. The editor suffixes its state directory
# with `-dev` for debug builds, and `SAWE_DEV_DIRS` overrides that in either
# direction. If this disagrees with the binary we wait on a socket the editor
# never binds, then time out.
channel_dir="sawe"
if [[ "$profile" == "dev" ]]; then
    channel_dir="sawe-dev"
fi
case "$(printf '%s' "${SAWE_DEV_DIRS:-}" | tr '[:upper:]' '[:lower:]')" in
    "") ;;
    1 | true | yes | on) channel_dir="sawe-dev" ;;
    *) channel_dir="sawe" ;;
esac

# `SAWE_HOME` is the only environment variable that moves this editor's paths:
# `paths::base_dir()` is `home_dir()/.spk/<channel>`, and
# `util::paths::home_dir()` reads `SAWE_HOME` and nothing else. This branch
# used to export `XDG_CONFIG_HOME` / `XDG_DATA_HOME` / `XDG_CACHE_HOME`, which
# no part of that chain reads — so the editor went on binding the real
# `~/.spk/<channel>/state/mcp.sock`, contending the maintainer's live lock,
# while this script timed out waiting on a socket nobody would ever create.
if [[ -n "$runtime_dir" ]]; then
    mkdir -p "$runtime_dir"
    runtime_dir="$(cd "$runtime_dir" && pwd)"
    export SAWE_HOME="$runtime_dir"
    socket_dir="$runtime_dir/.spk/$channel_dir/state"
else
    # Pin the editor's home-dir resolution to the real $HOME. A binary built
    # with `--features test-support` (needed for the workspace.screenshot MCP
    # tool) would otherwise hard-code /home/zed in util::paths::home_dir() and
    # fail to create its config/data dirs. Harmless for normal builds.
    export SAWE_HOME="$HOME"
    socket_dir="$HOME/.spk/$channel_dir/state"
fi
socket_path="$socket_dir/mcp.sock"
lock_path="$socket_dir/mcp.lock"
mkdir -p "$socket_dir"

# Strip stale socket (symlink to a /tmp/sawe-mcp*/mcp.sock that no live
# process owns) and stale lock (PID file pointing at a dead process). Done
# unconditionally and BEFORE any check that could exit non-zero — so a
# failed precheck never leaves the door open for a follow-up wait-loop to
# false-positive on the corpse of a previous run.
[[ -L "$socket_path" || -S "$socket_path" ]] && rm -f "$socket_path"
if [[ -f "$lock_path" ]]; then
    lock_pid="$(cat "$lock_path" 2>/dev/null || true)"
    if [[ -n "$lock_pid" ]] && ! kill -0 "$lock_pid" 2>/dev/null; then
        rm -f "$lock_path"
    fi
fi

if [[ ! -x "$binary" ]]; then
    echo "[run-mcp] building $binary (profile: $profile) ..."
    (cd "$repo_root" && cargo build "${cargo_flags[@]}")
fi

# Decide whether to run headless. If $DISPLAY is unset and mode wasn't
# forced to "display", use the native headless platform (no X server at
# all; offscreen wgpu rendering — see ADR-0002).
use_headless=0
if [[ "$mode" == "headless" ]]; then
    use_headless=1
elif [[ "$mode" == "display" ]]; then
    use_headless=0
elif [[ -z "${DISPLAY:-}" ]]; then
    use_headless=1
fi

cleanup() {
    if [[ -n "${editor_pid:-}" ]] && kill -0 "$editor_pid" 2>/dev/null; then
        kill -TERM "$editor_pid" 2>/dev/null || true
        wait "$editor_pid" 2>/dev/null || true
    fi
}
trap cleanup INT TERM EXIT

if (( use_headless )); then
    echo "[run-mcp] launching with native --headless platform"
    "$binary" --headless "${forward_args[@]}" &
else
    echo "[run-mcp] launching with display=$DISPLAY"
    "$binary" "${forward_args[@]}" &
fi
editor_pid=$!

# Wait up to 30s for the socket to appear.
for _ in $(seq 1 60); do
    if [[ -S "$socket_path" || -L "$socket_path" ]]; then
        break
    fi
    if ! kill -0 "$editor_pid" 2>/dev/null; then
        echo "[run-mcp] editor exited before socket appeared" >&2
        exit 1
    fi
    sleep 0.5
done

if [[ ! -S "$socket_path" && ! -L "$socket_path" ]]; then
    echo "[run-mcp] timeout waiting for $socket_path" >&2
    exit 1
fi

echo "[run-mcp] mcp socket ready: $socket_path (editor pid: $editor_pid)"
echo "[run-mcp] press Ctrl+C to stop"

wait "$editor_pid"
