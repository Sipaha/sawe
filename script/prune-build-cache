#!/usr/bin/env bash
# Reclaim disk from cargo without losing anything you still need.
#
# Why this exists: `target/` reached 1012 GB here — 56% of a 1.8 TB disk, which
# hit 99% full. Two separate things grow forever and nothing collects either:
#
#   1. superseded artifacts in `deps/` / `.fingerprint/` / `build/` — cargo
#      keeps every older version it has ever built;
#   2. `target/*/incremental/` — a pure rebuild cache; 374 GB in 5995 session
#      directories accumulated over two weeks.
#
# This script does both, because the two available tools each cover exactly one
# and neither covers the other (measured, see below).
#
#   step 1  cargo-sweep --time N   → (1). Verified on this repo: it leaves the
#           finished binaries alone, because `target/<profile>/<bin>` is a
#           HARDLINK to the copy in `deps/` — sweeping drops the deps link and
#           the top-level file survives with its link count going 2 → 1. That is
#           what makes it safe to run while the editor is executing
#           `target/release-fast/sawe`. It does NOT touch `incremental/`
#           (verified: after a sweep `deps/` was empty and `incremental/` intact).
#
#   step 2  this script            → (2). Removes incremental session dirs,
#           which cargo-sweep ignores. Binaries, `deps/` and `.fingerprint/`
#           are untouched, so the next build relinks rather than starting over.
#
# Do NOT use upstream's `script/clear-target-dir-if-larger-than`: its only
# callers are the CI workflows, all hard-disabled in this fork, and it is a
# blunt `rm -rf target/*` that WOULD take `target/release-fast/sawe` with it.
#
# Usage:
#   script/prune-build-cache                 # sweep >7d artifacts + all incremental
#   script/prune-build-cache --days 30       # keep the last 30 days of both
#   script/prune-build-cache --dry-run       # report only, delete nothing
#   script/prune-build-cache --no-sweep      # incremental only, skip cargo-sweep
#
# `--days` is the age threshold for both steps, with one asymmetry: incremental
# defaults to 0 ("drop the lot" — it is only a cache), while cargo-sweep is
# clamped to a minimum of 1 day so it can never sweep the artifacts of a build
# that has only just finished.
#
# Requires `cargo install cargo-sweep` for step 1; without it the script says so
# and still does step 2.
set -euo pipefail

days=0
dry_run=false
run_sweep=true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --days) days="${2:?--days needs a number}"; shift 2 ;;
        --dry-run) dry_run=true; shift ;;
        --no-sweep) run_sweep=false; shift ;;
        -h|--help) sed -n '2,/^set -euo/p' "$0" | sed 's/^# \{0,1\}//; $d'; exit 0 ;;
        *) echo "unknown argument: $1 (try --help)" >&2; exit 1 ;;
    esac
done

if [[ ! -f Cargo.toml || ! -d target ]]; then
    echo "run this from the repository root (Cargo.toml and target/ must be here)" >&2
    exit 1
fi

kb_of() { du -xs "$1" 2>/dev/null | cut -f1; }
human() { numfmt --to=iec --suffix=B --format='%.1f' "$(( ${1:-0} * 1024 ))" 2>/dev/null || echo "${1:-0}K"; }

# ---- step 1: superseded artifacts -------------------------------------------
if [[ "$run_sweep" == true ]]; then
    if command -v cargo-sweep >/dev/null 2>&1; then
        sweep_days=$(( days > 0 ? days : 7 ))
        echo "== cargo-sweep --time ${sweep_days} (superseded artifacts; binaries survive) =="
        if [[ "$dry_run" == true ]]; then
            cargo sweep --time "$sweep_days" --dry-run
        else
            cargo sweep --time "$sweep_days"
        fi
    else
        echo "== cargo-sweep not installed — skipping superseded artifacts =="
        echo "   \`cargo install cargo-sweep\` to enable step 1"
    fi
fi

# ---- step 2: incremental caches ---------------------------------------------
echo "== incremental caches (cargo-sweep does not touch these) =="
total_before=0
total_after=0
total_stale=0
found=false

for incremental in target/*/incremental; do
    [[ -d "$incremental" ]] || continue
    found=true
    profile="$(basename "$(dirname "$incremental")")"
    before="$(kb_of "$incremental")"
    total_before=$(( total_before + before ))

    # Spelled out rather than computed: `-mtime "+$((days-1))"` yields
    # `-mtime +-1` for the default, which GNU find happens to accept as "every
    # file" while bfs and BSD find reject it outright — the default would
    # silently prune nothing there.
    if [[ "$days" -le 0 ]]; then
        mapfile -t stale < <(find "$incremental" -mindepth 1 -maxdepth 1 -type d)
    else
        mapfile -t stale < <(find "$incremental" -mindepth 1 -maxdepth 1 -type d -mtime "+$(( days - 1 ))")
    fi

    dirs="$(find "$incremental" -mindepth 1 -maxdepth 1 -type d | wc -l)"
    stale_kb=0
    if [[ ${#stale[@]} -gt 0 ]]; then
        stale_kb="$(du -xsc -- "${stale[@]}" 2>/dev/null | tail -1 | cut -f1)"
    fi
    echo "${profile}/incremental: $(human "$before") in ${dirs} dirs — $(human "$stale_kb") in ${#stale[@]} to prune"

    if [[ ${#stale[@]} -gt 0 && "$dry_run" == false ]]; then
        rm -rf "${stale[@]}"
    fi
    total_stale=$(( total_stale + stale_kb ))

    after="$(kb_of "$incremental")"
    total_after=$(( total_after + after ))
done

if [[ "$found" == false ]]; then
    echo "no incremental caches under target/"
elif [[ "$dry_run" == true ]]; then
    echo "dry run: incremental would reclaim $(human "$total_stale")"
else
    echo "incremental reclaimed $(human $(( total_before - total_after )))"
fi
