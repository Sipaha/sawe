#!/usr/bin/env bash
# Manage Sawe prompt overrides without deleting user-authored prompt directories.
set -euo pipefail

usage() {
    echo "Usage: $0 [link [--worktree]|unlink]"
    echo "Link this repository's assets/prompts, or a sibling sawe_prompts worktree."
    echo "SAWE_HOME redirects the profile root; SAWE_DEV_DIRS=1 selects the dev profile."
}

operation="${1:-}"
if [[ "$operation" != link && "$operation" != unlink ]] || (( $# > 2 )) ||
    { (( $# == 2 )) && [[ "$operation" != link || "$2" != --worktree ]]; }; then
    usage
    exit 1
fi

repo_root="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
channel_dir=sawe
case "$(printf '%s' "${SAWE_DEV_DIRS:-}" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')" in
    1 | true | yes | on) channel_dir=sawe-dev ;;
esac
profile_root="${SAWE_HOME:-$HOME}/.spk/$channel_dir"
if [[ "$(uname -s)" == Darwin ]]; then
    override_path="$profile_root/config/prompt_overrides"
else
    override_path="$profile_root/data/prompt_overrides"
fi

# Both link and unlink may replace a symlink, including a dangling one, but
# must never remove a real file or a directory containing custom prompts.
if [[ -e "$override_path" && ! -L "$override_path" ]]; then
    echo "Refusing to replace $override_path: move your existing prompts explicitly first." >&2
    exit 1
fi

if [[ "$operation" == unlink ]]; then
    if [[ -L "$override_path" ]]; then
        rm -- "$override_path"
        echo "Unlinked $override_path"
    else
        echo "No prompt override link at $override_path"
    fi
    exit 0
fi

source_path="$repo_root/assets/prompts"
if [[ "${2:-}" == --worktree ]]; then
    worktree_path="$(dirname "$repo_root")/sawe_prompts"
    if ! git -C "$repo_root" worktree list --porcelain | grep -Fx "worktree $worktree_path" > /dev/null; then
        if git -C "$repo_root" show-ref --verify --quiet refs/heads/prompts; then
            git -C "$repo_root" worktree add "$worktree_path" prompts
        else
            git -C "$repo_root" worktree add -b prompts "$worktree_path"
        fi
    fi
    source_path="$worktree_path/assets/prompts"
fi
[[ -d "$source_path" ]] || { echo "Missing prompt templates: $source_path" >&2; exit 1; }
mkdir -p "$(dirname "$override_path")"
if [[ -L "$override_path" ]]; then
    rm -- "$override_path"
fi
ln -s -- "$source_path" "$override_path"
echo "Linked $source_path to $override_path"
echo "Prompt overrides remain active until you run '$0 unlink'."
